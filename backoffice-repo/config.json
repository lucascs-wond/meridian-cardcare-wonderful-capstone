{
  "profile": {
    "version": "1.0",
    "name": "mcc-backoffice",
    "display_name": "Meridian Dispute Backoffice",
    "description": "Agent 2 \u2014 asynchronous dispute decisions per rulebook. Triggered per case by authenticated webhook from Agent 1 dispute intake; decides auto_approve/auto_reject/request_info/close_resolved/blocked; creates Campaign consumers for actionable outcomes.",
    "mode": "backoffice",
    "locale": "en-US",
    "timezone": "UTC",
    "gender": "female"
  },
  "behavior": {
    "routing": {
      "mode": "automated"
    },
    "channels": {},
    "attachments": {
      "enabled": true,
      "upload_to_s3": true,
      "max_per_conversation": 0,
      "max_file_size_mb": 0,
      "max_extracted_text_chars": 0,
      "ocr_provider": "gemini",
      "ocr_options": {
        "model": "gemini-3.5-flash-lite",
        "temperature": 0.1
      }
    },
    "guardrails": {
      "pii": {
        "policies": [],
        "beep_padding_start_ms": 0,
        "beep_padding_end_ms": 0,
        "batch_verifier_enabled": false,
        "batch_verifier_max_retries": 0,
        "batch_verifier_continue_on_error": false,
        "pii_masking_thinking_budget": 0
      },
      "governance_enabled": false,
      "automated_issues_enabled": true
    },
    "privacy": {
      "call_recording": {
        "disabled": false,
        "require_consent": false,
        "upload_transcript": false
      },
      "data_retention": {
        "enabled": false
      }
    },
    "sandbox": {
      "cache_directory_enabled": false,
      "web_search_enabled": false,
      "ai_analyst_enabled": false,
      "coding_agent_enabled": false,
      "demo_fast_mode_enabled": false
    },
    "internal": {
      "compact_context": true,
      "use_dynamic_announcements": true,
      "prompts": {
        "dynamic_announcement": {}
      }
    },
    "capabilities": {
      "disable_json_diacritics": false,
      "disable_hours_and_numbers_diacritics": false
    },
    "tool_overrides": {},
    "global_tools": {
      "case-evidence": {
        "type": "programmable",
        "config": {}
      },
      "case-decide": {
        "type": "programmable",
        "config": {}
      },
      "case-notify": {
        "type": "programmable",
        "config": {}
      },
      "case-claim": {
        "type": "programmable",
        "config": {}
      }
    }
  },
  "ai": {
    "llm": {
      "voice": {
        "providers": {
          "openai": {
            "model": "gpt-realtime-1.5",
            "temperature": 0,
            "top_p": 0
          },
          "wonderful": {
            "model": "wonderful/gemma-4-31b-it",
            "temperature": 0,
            "top_p": 0
          }
        },
        "priority": [
          "wonderful",
          "openai"
        ],
        "failure_threshold": 3
      },
      "chat": {
        "providers": {
          "wonderful": {
            "model": "wonderful/gemma-4-31b-it",
            "temperature": 0,
            "top_p": 0
          }
        },
        "priority": [
          "wonderful"
        ],
        "failure_threshold": 3,
        "enabled": false
      }
    }
  },
  "prompts": {
    "agent": "base.md",
    "summary": "summary.md",
    "tags": "tags.md",
    "skip_turn": {},
    "read_directive": "internal_prompts/read_directive.md"
  },
  "a2a": {
    "server": {
      "internal_enabled": true,
      "enabled": false
    }
  }
}